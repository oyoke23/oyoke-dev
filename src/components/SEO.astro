---
import { site } from "../lib/site";
import { getAlternates, getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
}

const { title, description, image = "/og-default.png", article = false, publishedTime } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fallbackDescription = t("site.tagline");
const desc = description ?? fallbackDescription;

const fullTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const alternates = getAlternates(Astro.url);
const ogLocale = lang === "es" ? "es_ES" : "en_US";
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />

{alternates.map((a) => (
  <link rel="alternate" hreflang={a.lang} href={a.href} />
))}
<link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === defaultLang)?.href} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
