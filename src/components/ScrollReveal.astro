<script>
  function bindReveal() {
    const els = document.querySelectorAll<HTMLElement>(".reveal:not(.is-bound)");
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -80px 0px" }
    );
    els.forEach((el) => {
      el.classList.add("is-bound");
      io.observe(el);
    });
  }
  bindReveal();
  document.addEventListener("astro:after-swap", bindReveal);
</script>
