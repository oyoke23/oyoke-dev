---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  name: string;
  size?: number;
}

const { icon, name, size = 32 } = Astro.props;
---

<div class="skill-icon-cell">
  <Icon name={icon} size={size} class="skill-icon-svg" aria-label={name} />
  <span class="skill-icon-name">{name}</span>
</div>

<style>
  .skill-icon-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 0.875rem 0.5rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elev);
    transition:
      border-color 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
    min-width: 0;
  }
  .skill-icon-cell:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
  }
  .skill-icon-svg {
    flex-shrink: 0;
    color: var(--color-fg);
  }
  .skill-icon-name {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    text-align: center;
    line-height: 1.2;
    word-break: break-word;
  }
</style>
